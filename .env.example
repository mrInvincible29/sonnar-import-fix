# Application type: sonarr (default) or radarr
# APP_TYPE=sonarr

# Sonarr settings (required when APP_TYPE=sonarr)
SONARR_URL=http://localhost:8989/sonarr
SONARR_API_KEY=your-sonarr-api-key-here

# Radarr settings (required when APP_TYPE=radarr)
# RADARR_URL=http://localhost:7878/radarr
# RADARR_API_KEY=your-radarr-api-key-here

# Webhook settings (Sonarr only)
WEBHOOK_ENABLED=true
WEBHOOK_PORT=8090
# WEBHOOK_SECRET=  # Auto-generated if not set

# Monitoring settings
MONITORING_INTERVAL=60
FORCE_IMPORT_THRESHOLD=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Optional: Dry run mode
# DRY_RUN=false
